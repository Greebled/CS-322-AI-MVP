# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is listed in .gitignore -- never commit real keys.

# auto       -> use Claude if ANTHROPIC_API_KEY is set, otherwise keyword matching
# claude     -> always use Claude (falls back to keyword matching if the call fails)
# extractive -> never call an AI service (good for offline demos and grading)
AI_PROVIDER=auto

ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-haiku-5-5

FLASK_DEBUG=1
